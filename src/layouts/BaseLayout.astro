---
const { title, description = "Портфолио системного и бизнес-аналитика Александра Стяжкова" } =
  Astro.props;
import "../styles/style.css";
import ThemeToggle from "../components/ThemeToggle.astro";

const githubUrl = "https://github.com/styazhkoV";
const baseUrl = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Александр Стяжков" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical} />

    <meta
      name="google-site-verification"
      content="xrnWBINY_mvjJ1vLXStmJ780_g8g8OC3rkqhSvJKtts"
    />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Александр Стяжков",
      "jobTitle": "Системный и бизнес-аналитик",
      "url": "https://styazhkov.github.io",
      "sameAs": ["https://github.com/styazhkoV"],
      "knowsAbout": ["BPMN", "UML", "REST API", "SQL", "Системный анализ", "Бизнес-анализ"]
    })} />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="bg-primary min-h-screen flex flex-col">
    <header
      class="bg-secondary border-b border-themed sticky top-0 z-50 backdrop-blur-sm bg-opacity-90"
    >
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a
          href={baseUrl}
          class="text-xl font-bold tracking-tight text-gradient hover:opacity-80 transition-opacity"
        >
          STYAZHKOV.ANALYSIS
        </a>

        <nav class="flex items-center gap-6">
          <div class="hidden md:flex items-center gap-5 text-sm font-medium">
            <a href={`${baseUrl}#about`} class="text-secondary hover:text-primary transition-colors">Обо мне</a>
            <a href={`${baseUrl}#skills`} class="text-secondary hover:text-primary transition-colors">Навыки</a>
            <a href={`${baseUrl}#certificates`} class="text-secondary hover:text-primary transition-colors">Сертификаты</a>
            <a href={`${baseUrl}#experience`} class="text-secondary hover:text-primary transition-colors">Опыт</a>
            <a href={`${baseUrl}#cases`} class="text-secondary hover:text-primary transition-colors">Кейсы</a>
            <a href={`${baseUrl}blog/`} class="text-secondary hover:text-primary transition-colors">Блог</a>
            <a href={`${baseUrl}#contact`} class="text-secondary hover:text-primary transition-colors">Контакт</a>
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary hover:text-primary transition-colors"
              >GitHub</a
            >
          </div>

          <ThemeToggle />

          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-lg bg-tertiary border border-themed"
            aria-label="Открыть меню"
            type="button"
          >
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </nav>
      </div>

      <div id="mobile-menu" class="hidden md:hidden border-t border-themed">
        <nav class="flex flex-col p-4 gap-4 text-sm font-medium">
          <a href={`${baseUrl}#about`} class="text-secondary hover:text-primary">Обо мне</a>
          <a href={`${baseUrl}#skills`} class="text-secondary hover:text-primary">Навыки</a>
          <a href={`${baseUrl}#certificates`} class="text-secondary hover:text-primary">Сертификаты</a>
          <a href={`${baseUrl}#experience`} class="text-secondary hover:text-primary">Опыт</a>
          <a href={`${baseUrl}#cases`} class="text-secondary hover:text-primary">Кейсы</a>
          <a href={`${baseUrl}blog/`} class="text-secondary hover:text-primary">Блог</a>
          <a href={`${baseUrl}#contact`} class="text-secondary hover:text-primary">Контакт</a>
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-primary">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-secondary border-t border-themed">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-muted text-sm">
            © {new Date().getFullYear()} Александр Стяжков. Astro + Tailwind.
          </p>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary transition-colors text-sm"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>

    <script>
      const mobileMenuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");

      mobileMenuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu?.classList.add("hidden");
        });
      });
    </script>
  </body>
</html>
