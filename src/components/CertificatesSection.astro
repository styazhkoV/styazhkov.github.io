---
import certificates from "../data/certificates.json";
---

<section id="certificates" class="section bg-secondary">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="section-title">Сертификаты</h2>
      <p class="section-subtitle mx-auto">
        Достижения Microsoft Learn — клик открывает страницу подтверждения
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        certificates.map((cert) => (
          <a
            href={cert.link}
            target="_blank"
            rel="noopener noreferrer"
            class="card p-5 block group"
          >
            <span class="tag mb-3">{cert.issuer}</span>
            <h3 class="font-bold text-primary group-hover:text-gradient transition-colors mb-2">
              {cert.title}
            </h3>
            <p class="text-muted text-sm flex items-center gap-2">
              <span>{cert.date}</span>
              <svg
                class="w-4 h-4 opacity-60 group-hover:opacity-100"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
