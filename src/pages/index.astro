---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mermaid from "../components/Mermaid.astro";
import SkillsSection from "../components/SkillsSection.astro";
import CertificatesSection from "../components/CertificatesSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import CasesSection from "../components/CasesSection.astro";
import ContactForm from "../components/ContactForm.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const baseUrl = import.meta.env.BASE_URL;

const heroUseCase = `usecaseDiagram
  actor Работодатель
  actor GitHub
  actor Аналитик

  Работодатель --> (Просмотр Hero)
  Работодатель --> (Изучение Навыков)
  Работодатель --> (Просмотр Сертификатов)
  Работодатель --> (Просмотр Опыта)
  Работодатель --> (Открытие Кейсов)
  Работодатель --> (Чтение Блога)
  Работодатель --> (Связь через Контакты)

  (Чтение Блога) --> GitHub : Переход к коду
  Аналитик --> (Обновление контента)`;

const cases = sortedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  href: `${baseUrl}blog/${post.id}/`,
  category: post.data.category,
  tags: post.data.tags,
  kpi: post.data.kpi,
  diagram: post.data.diagram,
}));
---

<BaseLayout
  title="Стяжков Александр | Системный и бизнес-аналитик"
  description="Системный и бизнес-аналитик, 10+ лет опыта в финтех и IT. Интеграции, BPMN/UML, REST API, Microsoft Learn."
>
  <!-- Hero -->
  <section id="about" class="section bg-primary">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="animate-fade-in-up">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-tertiary rounded-full text-sm text-secondary mb-6"
          >
            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            Открыт к новым проектам
          </div>

          <p class="text-accent font-semibold mb-2">Александр Стяжков</p>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-black mb-6 leading-tight">
            Системный и бизнес-аналитик,<br />
            <span class="text-gradient">10+ лет опыта в финтех и IT</span>
          </h1>

          <p class="text-lg text-secondary mb-8 max-w-xl">
            Проектирую интеграции, моделирую бизнес-процессы и перевожу
            требования в работающие решения с измеримым результатом.
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="#cases" class="btn btn-primary">Смотреть кейсы</a>
            <a href="#contact" class="btn btn-secondary">Обсудить проект</a>
          </div>
        </div>

        <div class="w-full">
          <p class="text-sm text-muted mb-3 text-center lg:text-left">
            Use Case: как работодатель использует сайт
          </p>
          <Mermaid code={heroUseCase} />
        </div>
      </div>
    </div>
  </section>

  <SkillsSection />
  <CertificatesSection />
  <ExperienceSection />
  <CasesSection cases={cases} />
  <ContactForm />
</BaseLayout>
